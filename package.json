{
  "name": "shunt-shim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify-ingress": "node --experimental-strip-types scripts/verify-ingress.ts",
    "generate-token": "node --experimental-strip-types scripts/generate-token.ts"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "7.30.1"
    }
  }
}
