{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shunt-shim",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "enable_request_signal"
  ],
  "preview_urls": true,
  "routes": [
    {
      "pattern": "shunt-shim.gordon-pn.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
