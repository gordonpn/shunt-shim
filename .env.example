# Upstream LLM provider credentials (MVP: Groq primary, Gemini fallback)
GEMINI_API_KEY="your-google-ai-studio-api-key"
GROQ_API_KEY="your-groq-api-key"

# Gateway authentication secret (single secret for MVP)
GATEWAY_TOKENS="your-random-gateway-secret"

# Gateway configuration
GATEWAY_ENV="development"
PORT="8787"

# Optional endpoint, provider order, and model overrides (defaults match production contract)
# Note: PRIMARY_MODEL and FALLBACK_MODEL strictly permit only verified models
# (ALLOWED_PRIMARY_MODELS: qwen/qwen3.8-27b, ALLOWED_FALLBACK_MODELS: gemini-2.5-flash-lite)
# PRIMARY_PROVIDER="groq"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# PRIMARY_MODEL="qwen/qwen3.8-27b"
# FALLBACK_MODEL="gemini-2.5-flash-lite"
